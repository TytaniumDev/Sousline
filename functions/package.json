{
  "name": "sousvite-functions",
  "description": "Cloud Functions and security rules tests for Sousvite (ENGINEERING.md §9).",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "npm run build && firebase emulators:start --project demo-sousvite",
    "test": "npm run build && firebase emulators:exec --project demo-sousvite --only auth,firestore,functions,storage \"vitest run --coverage\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "firebase": "^13.3.0",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
